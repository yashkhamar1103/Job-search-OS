# Placeholders only. Never commit a real value to this file or to .env.
#
# Milestone 1 reads none of these. They are listed so the shape is fixed before
# milestone 2 needs them. In Azure (milestone 5) the API key is read from Key
# Vault through managed identity and is not present as an environment variable.

ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
AZURE_KEY_VAULT_URI=https://REPLACE-ME.vault.azure.net/
AZURE_STORAGE_ACCOUNT=replaceme
AZURE_STORAGE_CONTAINER=cv-runs
